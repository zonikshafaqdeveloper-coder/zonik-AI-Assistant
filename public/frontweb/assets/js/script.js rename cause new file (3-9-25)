document.addEventListener("DOMContentLoaded", function () {
    const targetPage = "/quoteslist"; // Target page where scroll should be stored
    const scrollPositionKey = "scrollPosition_quoteslist"; // Unique key for this page

    if (window.location.pathname === targetPage) {
        // Restore scroll position if available
        const storedScroll = sessionStorage.getItem(scrollPositionKey);
        if (storedScroll !== null && !isNaN(storedScroll)) {
            window.scrollTo(0, parseInt(storedScroll, 10));
        }

        // Save scroll position before page unload
        function saveScrollPosition() {
            sessionStorage.setItem(scrollPositionKey, window.scrollY);
        }

        window.addEventListener("beforeunload", saveScrollPosition);
        document.querySelectorAll("form").forEach(form => {
            form.addEventListener("submit", saveScrollPosition);
        });

    } else {
        // Clear stored scroll position when navigating away from quoteslist
        sessionStorage.removeItem(scrollPositionKey);
    }
});







