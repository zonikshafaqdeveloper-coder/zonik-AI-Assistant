function activateTab(tabButtonId, tabContentId) {
    const tabButton = document.getElementById(tabButtonId);
    const tabContent = document.getElementById(tabContentId);

    if (tabButton && tabContent) {
        // Deactivate all tabs and contents first
        deactivateAllTabs();

        // Activate the selected tab and content
        tabButton.classList.add('active');
        tabButton.setAttribute('aria-selected', 'true');
        tabContent.classList.add('active', 'show');

        const dropdownToggle = document.getElementById('v-pills-offer-dropdown-toggle');
        const dropdownParent = tabButton.closest('.dropdown');
        if (dropdownParent && dropdownToggle) {
            dropdownParent.classList.add('active');
            dropdownToggle.classList.add('active'); // Highlight the toggle
        }
    }
}

// Deactivate all tabs and content
function deactivateAllTabs() {
    document.querySelectorAll('.nav-link').forEach(tab => {
        tab.classList.remove('active');
        tab.setAttribute('aria-selected', 'false');
    });
    document.querySelectorAll('.tab-pane').forEach(content => {
        content.classList.remove('active', 'show');
    });
    document.querySelectorAll('.dropdown').forEach(dropdown => {
        dropdown.classList.remove('active');
    });
}

// Automatically activate the tab based on localStorage after page load
document.addEventListener('DOMContentLoaded', function () {
    // Define the localStorage key-map for tabs
    const localStorageKeyMap = {
        'activateCart': ['v-pills-rejected-tab', 'v-pills-rejected'],
        'offerListCount': ['v-pills-offer-tab', 'v-pills-offer'],
        'offerList': ['v-pills-offer-tab2', 'v-pills-offer2'],
        'quoteCounts': ['v-pills-enquiry-tab', 'v-pills-enquiry'],
        'pricelist': ['v-pills-price-tab', 'v-pills-price']
    };

    let activated = false; // Flag to check if a tab was activated

    // Deactivate all tabs first to ensure no tab is selected initially
    deactivateAllTabs();

    // Check localStorage for any active tab key and activate the corresponding tab
    for (const [key, [tabButtonId, tabContentId]] of Object.entries(localStorageKeyMap)) {
        if (localStorage.getItem(key) === 'true') {
            activateTab(tabButtonId, tabContentId); // Activate the tab
            activated = true;
            break; // Stop once the correct tab is activated
        }
    }

    // If no tab was activated, set a default tab (you can choose any tab here)
    if (!activated) {
        // Set 'quoteCounts' tab as default if no value is found in localStorage
        activateTab('v-pills-enquiry-tab', 'v-pills-enquiry');
    }
});





