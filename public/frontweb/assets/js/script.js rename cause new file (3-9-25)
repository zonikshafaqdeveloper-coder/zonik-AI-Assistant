$(document).ready(function () {
    let debounceTimer;
    let isSearching = false;

    $('.search_list').hide(); // Initially hide search results

    $('.search').on('keyup', function (event) {
        const query = $(this).val().trim();

        if (event.key === "Enter" && query.length > 0) {
            window.location.href = "https://zonik.in/search/" + encodeURIComponent(query);
            return;
        }

        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
            performSearch(query);
        }, 300);
    });

    function performSearch(query) {
        if (isSearching || query.length === 0) {
            $('.search_list').hide();
            return;
        }

        isSearching = true;
        $.ajax({
            url: "https://zonik.in/search",
            type: "GET",
            data: { search: query },
            success: function (data) {
                isSearching = false;

                if (!data || data.trim() === 'No results') {
                    handleNoResults(query);
                } else {
                    $('.search_list').html(data).show();
                }
            },
            error: function (xhr, status, error) { // Corrected function parameters
                isSearching = false;

                if (xhr.status === 401 || (xhr.responseURL && xhr.responseURL.includes("/login"))) {
                    handleLoggedOut();
                } else {
                    $('.search_list').html('<li>Unable to retrieve results. Please try again.</li>').show();
                    console.error("AJAX Error:", xhr.status, error);
                }
            }
        });
    }

    function handleNoResults(query) {
        $('.search_list').html('<li>No results found for "' + query + '"</li>').show();
    }

    function handleLoggedOut() {
        alert("Session expired. Please log in again.");
        window.location.href = "https://zonik.in/login";
    }
});









