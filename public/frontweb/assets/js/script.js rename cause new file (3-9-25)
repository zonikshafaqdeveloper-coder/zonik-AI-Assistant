function activateTabAndUpdateStorage(tabButtonId, tabContentId, localStorageKey) {
    activateTab(tabButtonId, tabContentId); // Activate the tab

    // Reset all localStorage keys to 'false'
    const keys = ['activateCart', 'offerListCount', 'quoteCounts', 'pricelist', 'offerList'];
    keys.forEach(key => localStorage.setItem(key, 'false'));

    // Set the active key to 'true'
    localStorage.setItem(localStorageKey, 'true');
}

