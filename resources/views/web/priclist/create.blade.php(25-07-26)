<script>
$(document).ready(function () {

    // ===== Outlet dropdown toggle =====
    $('#outletBtn').on('click', function (e) {
        e.stopPropagation();
        $(this).toggleClass('open');
        $('#outletDropdown').toggleClass('open');
    });

    $(document).on('click', function () {
        $('#outletBtn').removeClass('open');
        $('#outletDropdown').removeClass('open');
    });

    $('#outletDropdown').on('click', function (e) { e.stopPropagation(); });

    // ===== Switch outlet — calls existing web.outlet.choose route, reloads page =====
    $(document).on('click', '.pl-outlet-item[data-id]', function () {
        const outletId = $(this).data('id');
        const outletName = $(this).data('name');

        if ($(this).hasClass('current')) {
            $('#outletBtn').removeClass('open');
            $('#outletDropdown').removeClass('open');
            return;
        }

        $('#outletBtnLabel').text(outletName);
        $('#outletBtn').removeClass('open');
        $('#outletDropdown').removeClass('open');

        window.location.href = '/outlet-selection/choose/' + outletId + '?redirect=' + encodeURIComponent(window.location.pathname);
    });

    // ===== Quantity steppers =====
    $(document).on('click', '.pl-qty-minus', function () {
        const $qty = $(this).siblings('.pl-qty-value');
        let val = parseInt($qty.text()) || 1;
        if (val > 1) $qty.text(val - 1);
    });

    $(document).on('click', '.pl-qty-plus', function () {
        const $qty = $(this).siblings('.pl-qty-value');
        let val = parseInt($qty.text()) || 1;
        $qty.text(val + 1);
    });

    // ===== Add / Added toggle =====
    $(document).on('click', '.pl-add-btn', function () {
        const $btn = $(this);
        if ($btn.hasClass('to-add')) {
            $btn.removeClass('to-add').addClass('added').text('Added');
            updateCartSummary(1);
        } else {
            $btn.removeClass('added').addClass('to-add').text('Add');
            updateCartSummary(-1);
        }
    });

    // ===== Favorite toggle =====
    $(document).on('click', '.pl-fav-btn', function () {
        $(this).toggleClass('active');
    });

    function updateCartSummary(delta) {
        const $count = $('#cartCount');
        const $itemsCount = $('#cartItemsCount');
        let current = parseInt($count.text()) || 0;
        current = Math.max(0, current + delta);
        $count.text(current);
        $itemsCount.text(current);
    }

});
</script>
