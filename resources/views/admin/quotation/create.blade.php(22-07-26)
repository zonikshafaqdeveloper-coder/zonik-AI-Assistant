<script>
/*
|--------------------------------------------------------------------------
| PRODUCT_CACHE + FAST LOOKUP MAP
| Avoids re-scanning the whole array on every row interaction.
|--------------------------------------------------------------------------
*/
let PRODUCT_CACHE = [];
let PRODUCT_MAP = {}; // id -> product object, O(1) lookup instead of .find()/.forEach()

function buildProductMap() {
    PRODUCT_MAP = {};
    PRODUCT_CACHE.forEach(p => { PRODUCT_MAP[p.id] = p; });
}

function initSelect2($context) {
    $context.find('.product-select').each(function () {
        if ($(this).hasClass('select2-hidden-accessible')) {
            $(this).select2('destroy');
        }
        $(this).select2({ width: '100%', allowClear: true, dropdownParent: $('#quotationTable') });
    });
}

/*
|--------------------------------------------------------------------------
| BUILD DROPDOWN — called ONCE per row, not looped across all rows
|--------------------------------------------------------------------------
*/
function buildDropdownOptions() {
    let options = `<option value="">Search Product</option>`;
    PRODUCT_CACHE.forEach(p => {
        options += `
            <option value="${p.id}"
                data-brand="${p.brand ?? ''}"
                data-category="${p.category ?? ''}"
                data-cost="${p.cost_per_item ?? 0}"
                data-sale-price="${p.sale_price_loose_pcs ?? 0}"
                data-last-grn="${p.last_grn_date ?? ''}">
                ${p.product_name}
            </option>`;
    });
    return options;
}

/*
|--------------------------------------------------------------------------
| Instead of rebuilding every dropdown's HTML on every change (O(n^2) and
| slow for large quotations), we just disable/enable the picked option
| inside OTHER dropdowns. Much cheaper than full innerHTML rebuild + select2
| destroy/reinit across all rows.
|--------------------------------------------------------------------------
*/
function markProductUnavailable(productId, $excludeSelect) {
    if (!productId) return;
    $('.product-select').not($excludeSelect).each(function () {
        const $opt = $(this).find(`option[value="${productId}"]`);
        if ($opt.length && !$opt.prop('disabled')) {
            $opt.prop('disabled', true);
        }
    });
}

function markProductAvailable(productId) {
    if (!productId) return;
    $('.product-select').each(function () {
        const $opt = $(this).find(`option[value="${productId}"]`);
        if ($opt.length) {
            $opt.prop('disabled', false);
        }
    });
}

function updateSr() {
    $('#quotationTable tbody .sr').each(function (i) { $(this).text(i + 1); });
}

function addNewRow() {
    const tableBody = $('#quotationTable tbody');
    const rowCount = tableBody.children().length + 1;

    const $newRow = $(`
        <tr>
            <td class="sr">${rowCount}</td>
            <td><select class="form-control product-select select2">${buildDropdownOptions()}</select></td>
            <td><input type="text" class="form-control brand" readonly></td>
            <td><input type="text" class="form-control category" readonly></td>
            <td><input type="text" class="form-control cost-per-item" readonly></td>
            <td><input type="number" class="form-control sale-price-basic" step="0.01" min="0"></td>
            <td><input type="text" class="form-control profit-margin" readonly></td>
            <td><input type="number" class="form-control customer-price" step="0.01" min="0"></td>
            <td><input type="text" class="form-control total-saving" readonly></td>
            <td><input type="text" class="form-control last-grn-date" readonly></td>
            <td class="text-center">
                <button type="button" class="btn btn-sm remove-row" style="background:red;color:#fff;"><i class="fa fa-trash"></i></button>
            </td>
        </tr>
    `);

    tableBody.append($newRow);

    // Sync disabled state for already-picked products into this new dropdown
    getSelectedProductIds().forEach(id => {
        $newRow.find(`.product-select option[value="${id}"]`).prop('disabled', true);
    });

    initSelect2($newRow);
    updateSr();
    return $newRow;
}

function getSelectedProductIds() {
    let selected = [];
    $('.product-select').each(function () {
        let val = $(this).val();
        if (val) selected.push(val);
    });
    return selected;
}

/*
|--------------------------------------------------------------------------
| Profit Margin % = (Sale Price - Cost Per Item) / Cost Per Item * 100
| Now recalculates on ANY change to Sale Price (Basic), since it's editable.
|--------------------------------------------------------------------------
*/
function calculateProfitMargin($row) {
    const cost = parseFloat($row.find('.cost-per-item').val()) || 0;
    const salePrice = parseFloat($row.find('.sale-price-basic').val()) || 0;

    let marginText = '';
    if (cost > 0 && salePrice > 0) {
        const margin = ((salePrice - cost) / cost) * 100;
        marginText = margin.toFixed(2) + '%';
    }
    $row.find('.profit-margin').val(marginText);
}

// Total Saving % = (Customer Price - Sale Price Basic) / Sale Price Basic * 100
function calculateTotalSaving($row) {
    const salePrice = parseFloat($row.find('.sale-price-basic').val()) || 0;
    const customerPrice = parseFloat($row.find('.customer-price').val()) || 0;

    let savingText = '';
    if (salePrice > 0 && customerPrice > 0) {
        const saving = ((customerPrice - salePrice) / salePrice) * 100;
        savingText = saving.toFixed(2) + '%';
    }
    $row.find('.total-saving').val(savingText);
}

$(document).ready(function () {

    $('#lead_customer_id').select2({ width: '100%', allowClear: true });

    fetch("{{ route('products.for-quotation') }}")
        .then(res => res.json())
        .then(products => {
            PRODUCT_CACHE = products;
            buildProductMap();

            // Populate the single initial row + init select2, once
            $('.product-select').each(function () {
                $(this).html(buildDropdownOptions());
            });
            initSelect2($(document));
        })
        .catch(err => console.error('Failed to load products:', err));

    $('#addRowBtn').on('click', function () { addNewRow(); });

    $('#lead_customer_id').on('select2:select select2:clear', function () {

        const leadId = $(this).val();

        $('#customer_name, #mobile_number, #address, #payment_term').val('');

        if (!leadId) return;

        fetch(`/admin/lead-customer-details/${leadId}`)
            .then(res => res.json())
            .then(data => {
                $('#customer_name').val(data.customer_name ?? '');
                $('#mobile_number').val(data.mobile_number ?? '');
                $('#address').val(data.address ?? '');
                $('#payment_term').val(data.payment_term ?? '');
            });
    });

    const tableBody = $('#quotationTable tbody');

    tableBody.on('change', '.product-select', function () {

        const $row = $(this).closest('tr');
        const $select = $(this);
        const productId = $select.val();
        const previousId = $select.data('prev-selected') || null;

        // Free up the previously selected product (if switching)
        if (previousId && previousId !== productId) {
            markProductAvailable(previousId);
        }

        if (!productId) {
            $row.find('.brand, .category, .cost-per-item, .sale-price-basic, .profit-margin, .customer-price, .total-saving, .last-grn-date').val('');
            $select.data('prev-selected', null);
            return;
        }

        // O(1) lookup instead of scanning PRODUCT_CACHE
        const p = PRODUCT_MAP[productId];
        if (!p) return;

        $row.find('.brand').val(p.brand || '');
        $row.find('.category').val(p.category || '');
        $row.find('.cost-per-item').val(parseFloat(p.cost_per_item || 0).toFixed(2));
        $row.find('.sale-price-basic').val(parseFloat(p.sale_price_loose_pcs || 0).toFixed(2));
        $row.find('.last-grn-date').val(p.last_grn_date || 'No GRN Yet');
        $row.find('.customer-price').val('');
        $row.find('.total-saving').val('');

        calculateProfitMargin($row);

        // Disable this product in all OTHER dropdowns (cheap — no full rebuild)
        markProductUnavailable(productId, $select);
        $select.data('prev-selected', productId);

        if ($row.is(':last-child')) {
            addNewRow();
        }
    });

    // Sale Price (Basic) is now editable — recalc margin AND saving on change
    tableBody.on('input', '.sale-price-basic', function () {
        const $row = $(this).closest('tr');
        calculateProfitMargin($row);
        calculateTotalSaving($row);
    });

    tableBody.on('input', '.customer-price', function () {
        const $row = $(this).closest('tr');
        calculateTotalSaving($row);
    });

    tableBody.on('click', '.remove-row', function () {

        if (tableBody.children().length === 1) {
            Swal.fire({ icon: 'warning', title: 'Action Not Allowed', text: 'At least one product row is required.' });
            return;
        }

        const $row = $(this).closest('tr');
        const productId = $row.find('.product-select').val();

        if (productId) {
            markProductAvailable(productId);
        }

        $row.remove();
        updateSr();
    });

});

function buildQuotationPayload() {

    let items = [];

    $('#quotationTable tbody tr').each(function () {
        const $row = $(this);
        const $select = $row.find('.product-select');
        const productId = $select.val();
        if (!productId) return;

        const p = PRODUCT_MAP[productId] || {};

        items.push({
            product_id            : productId,
            brand                  : p.brand || '',
            category                : p.category || '',
            cost_per_item           : parseFloat($row.find('.cost-per-item').val()) || 0,
            sale_price_basic        : parseFloat($row.find('.sale-price-basic').val()) || 0,
            profit_margin           : parseFloat($row.find('.profit-margin').val()) || 0,
            customer_price          : parseFloat($row.find('.customer-price').val()) || 0,
            total_saving_percent    : parseFloat($row.find('.total-saving').val()) || 0,
            last_grn_date           : p.last_grn_date || null,
        });
    });

    return {
        lead_customer_id : $('#lead_customer_id').val(),
        quotation_date   : $('#quotation_date').val(),
        items            : items,
    };
}

$('#saveQuotationBtn').on('click', function () {

    const payload = buildQuotationPayload();

    if (!payload.lead_customer_id) {
        Swal.fire({ icon: 'warning', title: 'Outlet Required', text: 'Please select an outlet.' });
        return;
    }

    if (!payload.quotation_date) {
        Swal.fire({ icon: 'warning', title: 'Date Required', text: 'Please select a quotation date.' });
        return;
    }

    if (payload.items.length === 0) {
        Swal.fire({ icon: 'warning', title: 'No Products', text: 'Please add at least one product.' });
        return;
    }

    const hasNoCustomerPrice = payload.items.some(i => i.customer_price < 0);
    if (hasNoCustomerPrice) {
        Swal.fire({ icon: 'warning', title: 'Customer Price Required', text: 'Please enter customer price for all products.' });
        return;
    }

    Swal.fire({
        title: 'Saving Quotation...',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
    });

    fetch("{{ route('quotations.store') }}", {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content'),
            'Accept': 'application/json'
        },
        body: JSON.stringify(payload)
    })
    .then(async res => {
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || 'Something went wrong');
        return data;
    })
    .then(data => {
        Swal.fire('Success', data.message, 'success').then(() => {
            window.location.href = data.redirect_url;
        });
    })
    .catch(err => {
        Swal.fire('Error', err.message, 'error');
    });
});
</script>

