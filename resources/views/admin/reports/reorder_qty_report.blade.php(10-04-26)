<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

document.addEventListener("DOMContentLoaded", function(){

    const rows = document.querySelectorAll("tbody tr");

    rows.forEach(function(row){

        const spp = row.querySelector(".spp");
        const oss = row.querySelector(".oss_percent");

        function calculate(){

            let wcq = parseFloat(oss.dataset.wcq);

            let sppVal = parseFloat(spp.value);
            let ossPercent = parseFloat(oss.value);

            let ossQty = wcq * (ossPercent / 100);

            let roq = (wcq * sppVal) + ossQty;

            row.querySelector(".oss_qty").innerText = Math.round(ossQty);

            row.querySelector(".roq").innerText = Math.round(roq);

        }

        spp.addEventListener("change", calculate);
        oss.addEventListener("change", calculate);

    });

});

</script>
