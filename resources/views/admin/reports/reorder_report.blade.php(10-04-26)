<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

document.addEventListener("DOMContentLoaded", function () {

    const dropdowns = document.querySelectorAll('.lss_percent');

    dropdowns.forEach(function(dropdown){

        dropdown.addEventListener('change', function(){

            let row = this.closest("tr");

            let adc = parseFloat(this.dataset.adc);
            let slt = parseFloat(this.dataset.slt);
            let carton = parseFloat(this.dataset.carton);
            let stock = parseFloat(this.dataset.stock);

            let percent = parseFloat(this.value);

            /*
            LSS QTY
            */

            let lss_qty = (adc * slt) * (percent / 100);

            /*
            ROP
            */

            let rop = (slt * adc) + lss_qty;

            /*
            BOXES
            */

            let boxes = 0;

            if(carton > 0){
                boxes = Math.ceil(rop / carton);
            }

            /*
            Update Table
            */

            row.querySelector(".lss_qty").innerText = Math.round(lss_qty);

            row.querySelector(".rop").innerText = Math.round(rop);

            row.querySelector(".boxes").innerText = boxes;

            /*
            STATUS LOGIC
            */

            let statusHTML = "";
            let actionHTML = "";

            if(stock <= rop){

                statusHTML = '<span class="badge bg-danger">RED</span>';

                actionHTML = '<button class="btn btn-sm btn-danger">ADD TO DRAFT PO</button>';

            }
            else if(stock > rop && stock <= (rop * 1.10)){

                statusHTML = '<span class="badge bg-warning text-dark">WATCH</span>';

                actionHTML = '<button class="btn btn-sm btn-warning">ADD TO DRAFT PO</button>';

            }
            else{

                statusHTML = '<span class="badge bg-success">OK</span>';

                actionHTML = '';

            }

            row.querySelector(".status").innerHTML = statusHTML;

            row.querySelector(".action").innerHTML = actionHTML;

        });

    });

});

</script>

<script>
  document.querySelectorAll('.addToDraftPo').forEach(function(button){

    button.addEventListener('click', function(){

        let product_id = this.dataset.product;
        let vendor_id  = this.dataset.vendor;
        let qty        = this.dataset.qty;

        Swal.fire({
            title: "Are you sure?",
            text: "Add this item to Draft Purchase Order?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, Add",
        }).then((result)=>{

            if(result.isConfirmed){

                fetch("{{ route('admin.po.addDraftItem') }}",{

                    method:'POST',

                    headers:{
                        'Content-Type':'application/json',
                        'X-CSRF-TOKEN':'{{ csrf_token() }}'
                    },

                    body: JSON.stringify({
                        product_id:product_id,
                        vendor_id:vendor_id,
                        quantity:qty
                    })

                })
                .then(res=>res.json())
                .then(data=>{

                    Swal.fire({
                        icon:'success',
                        title:'Success',
                        text:data.message
                    }).then(()=>{

                        location.reload();

                    });

                });

            }

        });

    });

});


</script>


