<script>
function reinitSelect2($container) {
    $container.find('select').select2({ width: '100%' });
}

$(document).ready(function () {
    reinitSelect2($(document));
});

/* Remove row */
$(document).on('click', '.remove-row', function () {
    $(this).closest('tr').remove();
});

/* Add row for same product */
$(document).on('click', '.add-row', function () {

    const $row = $(this).closest('tr');
    const productId = $row.data('product');

    const $productRows = $('#rackTable tbody tr').filter(function () {
        return $(this).data('product') == productId;
    });

    // destroy select2 before cloning
    $productRows.find('select').select2('destroy');

    const newRow = $row.clone();
    newRow.find('.store-qty').val(0);
    newRow.find('select').val('');

    const $last = $productRows.last();
    $last.after(newRow);

    // reinit
    const $updated = $('#rackTable tbody tr').filter(function () {
        return $(this).data('product') == productId;
    });

    reinitSelect2($updated);
});


$(document).on('change', '.rack-select', function () {

    const rack = $(this).val();
    const $row = $(this).closest('tr');

    const $level = $row.find('.level-select');
    const $slot  = $row.find('.slot-select');

    if (['F1','F2','F3','F4','F5','F6'].includes(rack)) {

        $level.val('').prop('disabled', true).removeAttr('required');
        $slot.val('').prop('disabled', true).removeAttr('required');

    } else {

        $level.prop('disabled', false).attr('required', true);
        $slot.prop('disabled', false).attr('required', true);
    }
});



/* Build payload */
function buildRackReceivingPayload() {

    let items = [];
    let usedLocations = [];
    let productTotals = {};

    $('#rackTable tbody tr').each(function () {

        const $row = $(this);
        const productId = $row.data('product');
        const productName = $row.data('product-name');

        const rack  = $row.find('.rack-select').val();
        const level = $row.find('.level-select').val();
        const slot  = $row.find('.slot-select').val();
        const qty   = parseFloat($row.find('.store-qty').val()) || 0;
        const isFridge = ['F1','F2','F3','F4','F5','F6'].includes(rack);

           if (!rack) {
            throw { title:'Rack Required', message:`Select Rack for ${productName}` };
        }

        if (!isFridge) {
            if (!level) {
                throw { title:'Level Required', message:`Select Level for ${productName}` };
            }
            if (!slot) {
                throw { title:'Slot Required', message:`Select Slot for ${productName}` };
            }
        }

        // const key = `${rack}-${level}-${slot}`;
        // if (usedLocations.includes(key)) {
        //     throw {
        //         title:'Duplicate Location',
        //         message:`Location ${key} already assigned. Choose another for ${productName}`
        //     };
        // }
        // usedLocations.push(key);

        if (!productTotals[productId]) {
            productTotals[productId] = { total:0, name:productName };
        }
        productTotals[productId].total += qty;

        items.push({
            product_id: productId,
            rack_no: rack,
            level_no: level,
            slot_no: slot,
            quantity: qty,
            batch_no    : $row.find('.batch-no').val() || null,
            expiry_date : $row.find('.expiry-date').val() || null

        });
    });

    if (items.length === 0) {
        throw { title:'No Data', message:'No rack allocation found' };
    }

    return { items: items };
}

/* Save update */
$('#saveRackBtn').on('click', function () {

    let payload;

    try {
        payload = buildRackReceivingPayload();
    } catch (err) {
        Swal.fire(err.title, err.message, 'warning');
        return;
    }

    Swal.fire({
        title: 'Updating Rack Allocation...',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
    });

    fetch("{{ route('admin.rack.receiving.update', $grn->id) }}", {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
        },
        body: JSON.stringify(payload)
    })
    .then(res => res.json())
    .then(res => {
        Swal.close();
        if (res.success) {
            Swal.fire('Updated', res.message, 'success')
                .then(() => window.location.href = res.redirect_url);
        } else {
            Swal.fire('Failed', res.message, 'error');
        }
    })
    .catch(() => {
        Swal.close();
        Swal.fire('Server Error','Something went wrong','error');
    });
});
</script>
