<script>
$(document).on('input', '.quantity-input', function () {

    const available = parseFloat($(this).data('available')) || 0;
    let val = parseFloat($(this).val()) || 0;

    if (val < 0) {
        $(this).val(0);
        return;
    }

    if (val > available) {
        Swal.fire(
            'Stock Not Available',
            'Entered quantity exceeds available stock (' + available + ')',
            'error'
        );
        $(this).val(available);
    }
});
</script>

