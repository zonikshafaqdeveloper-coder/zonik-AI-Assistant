                        <script>
                            function confirmDelete(orderItemId) {
                                Swal.fire({
                                    title: 'Are you sure?',
                                    text: 'You are about to delete this order item. This action cannot be undone.',
                                    icon: 'warning',
                                    showCancelButton: true,
                                    confirmButtonColor: '#d33',
                                    cancelButtonColor: '#3085d6',
                                    confirmButtonText: 'Yes, delete it!'
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        deleteOrderItem(orderItemId);
                                    }
                                });
                            }

                            function deleteOrderItem(orderItemId) {
                                var token = "{{ csrf_token() }}";
                                $.ajax({
                                    url: '/delete-order-item/' + orderItemId,
                                    data: {
                                        '_token': token
                                    },
                                    type: 'DELETE',
                                    success: function(response) {
                                      location.reload();
                                    },
                                    error: function(xhr, status, error) {

                                    }
                                });
                            }


                            function acceptOrder(orderId) {
                                var token = "{{ csrf_token() }}";
                                $.ajax({
                                    url: '/accept-order/' + orderId,
                                    type: 'POST',
                                    data: {
                                        '_token': token
                                    },
                                    success: function(response) {
                                    window.location.href = '{{ route("order.details") }}';
                                    },
                                    error: function(xhr, status, error) {
                                    }
                                });
                            }

                            function cancelOrder(orderId) {
                                var token = "{{ csrf_token() }}";
                                $.ajax({
                                    url: '/cancel-order/' + orderId,
                                    type: 'POST',
                                    data: {
                                        '_token': token
                                    },
                                    success: function(response) {
                                        window.location.href = '{{ route("order.details") }}';
                                    },
                                    error: function(xhr, status, error) {
                                        // Handle error
                                    }
                                });
                            }
                        </script>

<script>
    $(function() {
        // Update quantity via AJAX when the quantity input field is changed
        $("input.quantity-input").on('input', function() {
            var orderItemId = $(this).data('order-item-id');
            var newQuantity = $(this).val();  // Get the new value of quantity

            console.log("Order Item ID:", orderItemId);  // Debugging
            console.log("New Quantity:", newQuantity);   // Debugging

            // Prepare form data for AJAX request
            var csrfToken = $('meta[name="csrf-token"]').attr('content');
            var formData = {
                _token: csrfToken,
                quantity: newQuantity,
                order_item_id: orderItemId,
            };

            // Log the form data being sent in the request
            console.log("Form Data:", formData);  // Debugging

            // Send the AJAX request to update quantity
            $.ajax({
                url: "{{ route('orderItem.updateQuantity') }}",  // Your route to handle the update
                type: "POST",
                data: formData,
                success: function(response) {
                    // Log the response from the server
                    console.log("Server Response:", response);  // Debugging response

                    // if (response.success) {
                    //     alert('Quantity updated successfully!');
                    // } else {
                    //     alert('Failed to update quantity.');
                    // }
                },
                error: function(xhr, status, error) {
                    // Log any errors during the AJAX request
                    console.error('AJAX error:', error);  // Debugging
                    console.log("XHR response:", xhr.responseText);  // Debugging response text
                }
            });
        });
    });
</script>


