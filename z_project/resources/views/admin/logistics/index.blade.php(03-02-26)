<script>
let currentSelect = null;

/* Load all delivery modes into dropdown */
function loadDeliveryModes() {
    $.get("{{ route('delivery.modes.list') }}", function (data) {

        $('.mode-select').each(function () {
            let selectedMode = $(this).data('selected'); // get DB value
            let options = '<option value="">Select Mode</option>';
            options += '<option value="new">+ Add New Mode</option>';

            data.forEach(function (mode) {
                let selected = (mode.id == selectedMode) ? 'selected' : '';
                options += `<option value="${mode.id}" ${selected}>${mode.name}</option>`;
            });

            $(this).html(options);
        });
    });
}


loadDeliveryModes();

/* Open modal when + Add New Mode is selected */
$(document).on('change', '.mode-select', function () {
    console.log("Dropdown changed:", $(this).val());

    if ($(this).val() === 'new') {
        console.log("Add New Mode selected, opening modal");
        currentSelect = $(this);

        let modal = new bootstrap.Modal(document.getElementById('modeModal'));
        modal.show();
    }
});
</script>

<script>
/* Save new mode via AJAX */
$('#saveModeBtn').click(function () {
    let modeName = $('#newModeName').val().trim();
    console.log("Save button clicked. Mode name:", modeName);

    if (!modeName) {
        alert("Mode name is required");
        return;
    }

    $.ajax({
        url: "{{ route('delivery.modes.store') }}",
        type: "POST",
        data: {
            name: modeName,
            _token: "{{ csrf_token() }}"
        },
success: function (res) {
    console.log("Mode saved in DB:", res);

    // Add new option to all dropdowns
    $('.mode-select').append(
        `<option value="${res.id}">${res.name}</option>`
    );

    // Select and save directly
    if (currentSelect) {
        currentSelect.val(res.id);

        let row = currentSelect.closest('tr');
        let orderId = row.data('order-id');

        console.log("Direct saving new mode for order:", orderId, "Mode:", res.id);
        saveSingleField(orderId, 'mode_of_delivery_id', res.id);
    }

    // Close modal
    let modalElement = document.getElementById('modeModal');
    let modalInstance = bootstrap.Modal.getInstance(modalElement);
    modalInstance.hide();

    $('#newModeName').val('');
},

        error: function (err) {
            console.error("Error saving mode:", err);
            alert(err.responseJSON.message);
        }
    });
});
</script>

<script>
function saveSingleField(orderId, field, value) {
    console.log("Saving field:", field, "Order:", orderId, "Value:", value);

    $.ajax({
        url: "{{ route('order.logistics.store.single') }}",
        type: "POST",
        data: {
            _token: "{{ csrf_token() }}",
            order_id: orderId,
            field: field,
            value: value
        },
        success: function (res) {
            console.log("Field saved successfully:", res);
        },
        error: function (err) {
            console.error("Error saving field:", err);
        }
    });
}

/* Triggers */

// Rack No
$(document).on('keyup', '.rack-no', function () {
    let orderId = $(this).closest('tr').data('order-id');
    console.log("Rack changed:", $(this).val());
    saveSingleField(orderId, 'rack_no', $(this).val());
});

// No of Box
// No of Box (save instantly while typing)
$(document).on('input', '.no-of-box', function () {
    let orderId = $(this).closest('tr').data('order-id');
    console.log("Box typing:", $(this).val());
    saveSingleField(orderId, 'no_of_box', $(this).val());
});


// Priority
$(document).on('change', '.delivery-priority', function () {
    let orderId = $(this).closest('tr').data('order-id');
    console.log("Priority changed:", $(this).val());
    saveSingleField(orderId, 'delivery_priority', $(this).val());
});

// Mode of delivery
$(document).on('change', '.mode-select', function () {
    let val = $(this).val();
    console.log("Mode changed:", val);

    if (val === 'new') {
        console.log("New mode option chosen, skipping save");
        return;
    }

    let orderId = $(this).closest('tr').data('order-id');
    console.log("Saving mode for order:", orderId, "Mode ID:", val);

    saveSingleField(orderId, 'mode_of_delivery_id', val);
});
</script>

