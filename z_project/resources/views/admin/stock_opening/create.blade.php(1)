// Remove row
$(document).on('click', '.remove-row', function () {

    let totalRows = $('#openingStockTable tbody tr').length;

    // Do not allow deleting the last row
    if (totalRows <= 1) {
        Swal.fire({
            title: 'Action Not Allowed',
            text: 'At least one row is required to add opening stock.',
            icon: 'warning',
            confirmButtonText: 'OK'
        });
        return;
    }

    // Otherwise remove the row
    $(this).closest('tr').remove();
});

$('#saveOpeningStock').on('click', function () {

    let isValid = true;
    let rackMap = {};
    let formData = [];
    let errorMsg = '';

    $('#openingStockTable tbody tr').each(function (index) {

        let product   = $(this).find('[name*="[product_id]"]').val();
        let batch     = $(this).find('[name*="[batch_no]"]').val();
        let expiry    = $(this).find('[name*="[expiry_date]"]').val();
        let qty       = $(this).find('[name*="[quantity]"]').val();
        let rack      = $(this).find('[name*="[rack_no]"]').val();
        let level     = $(this).find('[name*="[level_no]"]').val();
        let slot      = $(this).find('[name*="[slot_no]"]').val();

        // Required validation
        if (!product || !qty || !rack || !level || !slot) {
            isValid = false;
            errorMsg = `Row ${index + 1}: Please fill all required fields.`;
            return false;
        }

        if (qty <= 0) {
            isValid = false;
            errorMsg = `Row ${index + 1}: Quantity must be greater than 0.`;
            return false;
        }

        // Duplicate rack-level-slot validation
        let rackKey = rack + '-' + level + '-' + slot;
        if (rackMap[rackKey]) {
            isValid = false;
            errorMsg = `Duplicate rack location found: Rack ${rack}, Level ${level}, Slot ${slot}.`;
            return false;
        }
        rackMap[rackKey] = true;

        formData.push({
            product_id: product,
            batch_no: batch,
            expiry_date: expiry,
            quantity: qty,
            rack_no: rack,
            level_no: level,
            slot_no: slot
        });
    });

    if (!isValid) {
        Swal.fire({
            title: 'Validation Error',
            text: errorMsg,
            icon: 'error',
            confirmButtonText: 'Fix it'
        });
        return;
    }

    // Confirm before saving
    Swal.fire({
        title: 'Confirm Save',
        text: 'Do you want to save this opening stock?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Yes, Save',
        cancelButtonText: 'Cancel'
    }).then((result) => {

        if (result.isConfirmed) {

            $.ajax({
                url: "{{ route('admin.stock-opening.store') }}",
                type: "POST",
                data: {
                    _token: $('meta[name="csrf-token"]').attr('content'),
                    items: formData
                },
                beforeSend: function () {
                    Swal.fire({
                        title: 'Saving...',
                        text: 'Please wait while saving opening stock.',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });
                },
               success: function (response) {
                Swal.fire({
                    title: 'Success',
                    text: response.message,
                    icon: 'success'
                }).then(() => {
                    if (response.redirect_url) {
                        window.location.href = response.redirect_url;
                    } else {
                        location.reload();
                    }
                });
            },

                error: function (xhr) {
                    Swal.fire({
                        title: 'Error',
                        text: xhr.responseJSON?.message || 'Something went wrong while saving.',
                        icon: 'error'
                    });
                }
            });
        }
    });
});

</script>


