<script>
(function () {
  'use strict';

  /* ── LIVE DATE ── */
  var dEl = document.getElementById('dashDate');
  if (dEl) {
    dEl.textContent = new Date().toLocaleString('en-IN', {
      weekday:'short', month:'short', day:'numeric',
      hour:'2-digit', minute:'2-digit'
    });
  }

  /* ── COUNTER ANIMATION ── */
  function animCount(el, target, dur) {
    target = parseFloat(target) || 0;
    dur = dur || 1600;
    if (target === 0) { el.textContent = '0'; return; }
    var s = performance.now();
    (function tick(ts) {
      var p = Math.min((ts - s) / dur, 1);
      var e = 1 - Math.pow(1 - p, 4);
      el.textContent = Math.round(e * target).toLocaleString('en-IN');
      if (p < 1) requestAnimationFrame(tick);
    })(s);
  }

  document.querySelectorAll('.dc').forEach(function(el) { animCount(el, el.dataset.val, 1600); });
  document.querySelectorAll('.dm').forEach(function(el) { animCount(el, el.dataset.val, 1900); });

  /* ── PROGRESS BARS ── */
  setTimeout(function() {
    document.querySelectorAll('.sc-bar-f').forEach(function(el) {
      var w = el.style.width; el.style.width = '0%';
      requestAnimationFrame(function(){ requestAnimationFrame(function(){ el.style.width = w; }); });
    });
  }, 300);

  /* ── CHART.JS v4 DEFAULTS (light theme) ── */
  Chart.defaults.color       = '#8a93a8';
  Chart.defaults.font.family = 'DM Sans, sans-serif';
  Chart.defaults.font.size   = 11;
  Chart.defaults.plugins.legend.display = false;

  var TIP = {
    backgroundColor : '#ffffff',
    borderColor     : 'rgba(0,0,0,0.1)',
    borderWidth     : 1,
    titleColor      : '#1a1f36',
    bodyColor       : '#4a5568',
    padding         : 12,
    cornerRadius    : 10,
    displayColors   : true,
    boxWidth        : 9,
    boxHeight       : 9
  };

  /* ── LEGEND BUILDER ── */
  function mkLegend(id, labels, colors, data) {
    var total = data.reduce(function(a,b){ return a + (b||0); }, 0);
    var el = document.getElementById(id);
    if (!el) return;
    el.innerHTML = labels.map(function(lbl, i) {
      var pct = total > 0 ? Math.round((data[i]||0) / total * 100) : 0;
      return '<div class="cc-leg-row">' +
        '<div class="cc-leg-dot" style="background:' + colors[i] + '"></div>' +
        '<span class="cc-leg-name">' + lbl + '</span>' +
        '<span class="cc-leg-pct">' + pct + '%</span>' +
      '</div>';
    }).join('');
  }

  /* ════════════════════════════
     1. DELIVERY — pie
  ════════════════════════════ */
  var dLbls   = {!! json_encode(array_keys($deliverydata)) !!};
  var dData   = {!! json_encode(array_values($deliverydata)) !!};
  var dColors = ['#f43f5e','#3b82f6','#10b981','#f59e0b','#8b5cf6','#06b6d4','#14b8a6'];

  new Chart(document.getElementById('deliveryChart'), {
    type: 'pie',
    data: {
      labels: dLbls,
      datasets: [{ data:dData, backgroundColor:dColors, borderColor:'#fff', borderWidth:3 }]
    },
    options: { plugins:{ tooltip:TIP }, animation:{ duration:1100 } }
  });
  mkLegend('deliveryLegend', dLbls, dColors, dData);

  /* ════════════════════════════
     2. ENQUIRY — doughnut (direct DB counts)
  ════════════════════════════ */
  var eqLabels = ["Pending","Submitted"];
  var eqPendingVal   = {{ $enquiryPending }};
  var eqSubmittedVal = {{ $enquirySubmitted }};
  var eqData   = [eqPendingVal, eqSubmittedVal];
  var eqColors = ["#f59e0b","#06b6d4"];

  if (eqPendingVal > 0 || eqSubmittedVal > 0) {
    new Chart(document.getElementById("enquiryChart"), {
      type: "doughnut",
      data: {
        labels: eqLabels,
        datasets: [{ data:eqData, backgroundColor:eqColors, borderColor:"#fff", borderWidth:3, borderRadius:5, hoverOffset:10 }]
      },
      options: { cutout:"65%", plugins:{ tooltip:TIP }, animation:{ duration:1100 } }
    });
    mkLegend("enquiryLegend", eqLabels, eqColors, eqData);
  } else {
    document.getElementById("enquiryChart").style.display = "none";
    document.getElementById("enquiryLegend").innerHTML =
      '<div style="text-align:center;padding:36px 10px;color:#8a93a8;">' +
      '<div style="font-size:26px;margin-bottom:8px;">📋</div>' +
      '<div style="font-size:12px;font-weight:600;">No enquiry data yet</div>' +
      '</div>';
  }

  /* ════════════════════════════
     3. RESPONSE — doughnut
  ════════════════════════════ */
  var rLabels = ['Accepted','Rejected','Re-offer'];
  var rData   = [
    {{ isset($data['accept'])   ? $data['accept']   : 0 }},
    {{ isset($data['rejected']) ? $data['rejected'] : 0 }},
    {{ isset($data['reoffer'])  ? $data['reoffer']  : 0 }}
  ];
  var rColors = ['#3b82f6','#f43f5e','#06b6d4'];

  new Chart(document.getElementById('responseChart'), {
    type: 'doughnut',
    data: {
      labels: rLabels,
      datasets: [{ data:rData, backgroundColor:rColors, borderColor:'#fff', borderWidth:3, borderRadius:5, hoverOffset:10 }]
    },
    options: { cutout:'65%', plugins:{ tooltip:TIP }, animation:{ duration:1200 } }
  });
  mkLegend('responseLegend', rLabels, rColors, rData);

  /* ════════════════════════════
     4. CUSTOMER RESPONSE — horizontal bar
  ════════════════════════════ */
  var cLabels = ['Responded','Not Responded'];
  var cData   = [{{ $responsedata['responded'] ?? 0 }}, {{ $responsedata['not_responded'] ?? 0 }}];
  var cColors = ['#10b981','#94a3b8'];

  new Chart(document.getElementById('responseChartData'), {
    type: 'bar',
    data: {
      labels: cLabels,
      datasets: [{
        data: cData,
        backgroundColor: ['rgba(16,185,129,0.15)','rgba(148,163,184,0.15)'],
        borderColor: cColors,
        borderWidth: 2, borderRadius: 8, borderSkipped: false
      }]
    },
    options: {
      indexAxis: 'y',
      plugins: { tooltip: TIP },
      scales: {
        x: { grid:{ color:'rgba(0,0,0,0.04)' }, ticks:{ color:'#8a93a8' }, border:{ color:'transparent' } },
        y: { grid:{ display:false }, ticks:{ color:'#4a5568', font:{ weight:'600' } }, border:{ color:'transparent' } }
      },
      animation: { duration:1300 }
    }
  });
  mkLegend('custLegend', cLabels, cColors, cData);

  /* ════════════════════════════
     5. MONTHLY ORDERS — line
  ════════════════════════════ */
  var oCtx  = document.getElementById('orderChart').getContext('2d');
  var oGrad = oCtx.createLinearGradient(0, 0, 0, 300);
  oGrad.addColorStop(0, 'rgba(59,130,246,0.2)');
  oGrad.addColorStop(1, 'rgba(59,130,246,0.0)');

  new Chart(oCtx, {
    type: 'line',
    data: {
      labels: {!! json_encode(array_keys($orderdata)) !!},
      datasets: [{
        label: 'Total Orders',
        data:  {!! json_encode(array_values($orderdata)) !!},
        borderColor: '#3b82f6', backgroundColor: oGrad,
        borderWidth: 2.5, fill: true, tension: 0.42,
        pointBackgroundColor: '#3b82f6', pointBorderColor: '#fff',
        pointBorderWidth: 2, pointRadius: 5, pointHoverRadius: 7
      }]
    },
    options: {
      plugins: {
        legend: { display:true, labels:{ color:'#4a5568', usePointStyle:true, pointStyle:'circle', boxWidth:8, padding:14 } },
        tooltip: TIP
      },
      scales: {
        x: { grid:{ color:'rgba(0,0,0,0.04)' }, ticks:{ color:'#8a93a8' }, border:{ color:'rgba(0,0,0,0.06)' } },
        y: { grid:{ color:'rgba(0,0,0,0.04)' }, ticks:{ color:'#8a93a8' }, border:{ color:'rgba(0,0,0,0.06)' }, beginAtZero:true }
      },
      animation: { duration:1500 }
    }
  });

  /* ════════════════════════════
     6. PRODUCT EXPENSES — dual line
  ════════════════════════════ */
  var eCtx  = document.getElementById('monthlySalesChart').getContext('2d');
  var sGrad = eCtx.createLinearGradient(0, 0, 0, 300);
  sGrad.addColorStop(0, 'rgba(59,130,246,0.18)');
  sGrad.addColorStop(1, 'rgba(59,130,246,0)');
  var bGrad = eCtx.createLinearGradient(0, 0, 0, 300);
  bGrad.addColorStop(0, 'rgba(244,63,94,0.18)');
  bGrad.addColorStop(1, 'rgba(244,63,94,0)');

  new Chart(eCtx, {
    type: 'line',
    data: {
      labels: {!! json_encode(array_keys($monthlyTotalPrices)) !!},
      datasets: [
        {
          label: 'Selling Price',
          data:  {!! json_encode(array_values($monthlyTotalPrices)) !!},
          borderColor:'#3b82f6', backgroundColor:sGrad,
          borderWidth:2.5, fill:true, tension:0.42,
          pointBackgroundColor:'#3b82f6', pointBorderColor:'#fff',
          pointBorderWidth:2, pointRadius:4, pointHoverRadius:6
        },
        {
          label: 'Purchase Price',
          data:  {!! json_encode(array_values($monthlyProductTotalPrices)) !!},
          borderColor:'#f43f5e', backgroundColor:bGrad,
          borderWidth:2.5, fill:true, tension:0.42,
          pointBackgroundColor:'#f43f5e', pointBorderColor:'#fff',
          pointBorderWidth:2, pointRadius:4, pointHoverRadius:6
        }
      ]
    },
    options: {
      plugins: {
        legend: { display:true, labels:{ color:'#4a5568', usePointStyle:true, pointStyle:'circle', boxWidth:8, padding:20 } },
        tooltip: TIP
      },
      scales: {
        x: { grid:{ color:'rgba(0,0,0,0.04)' }, ticks:{ color:'#8a93a8' }, border:{ color:'rgba(0,0,0,0.06)' } },
        y: {
          grid: { color:'rgba(0,0,0,0.04)' },
          ticks: { color:'#8a93a8', callback:function(v){ return v>=1000?'₹'+(v/1000).toFixed(0)+'k':'₹'+v; } },
          border: { color:'rgba(0,0,0,0.06)' }, beginAtZero:true
        }
      },
      animation: { duration:1700 }
    }
  });

})();
</script>

@endsection
