    private function generateUniqueMessageId()
    {
        return time() . rand(100, 999);
    }

    public function sendSMS($phone, $message, $otp = '')
    {
        $now = Carbon::now();
        $date = Carbon::now()->subMinutes(5);

      
        $last = SMS::where('mobile', $phone)
            ->where('otp', (int)$otp)
            ->whereBetween('created_at', [$date, $now])
            ->first();

        if ($last) {
            return [
                "success" => false,
                "message" => "message_sent_failed",
                "ErrorMessage" => "Same message already sent on given number."
            ];
        }

        $messageParts = explode('|', $message);
        $text = $messageParts[0];

        
        $sms = new SMS();
        $sms->message_id = $this->generateUniqueMessageId();
        $sms->mobile = $phone;
        $sms->message = $text;
        $sms->error = null;

        if (!empty($otp)) {
            $sms->otp = $otp;
        }

        $sms->save();

        return [
            "success" => true,
            "message" => "message_sent"
        ];
    }

    public function verifyOtp($mobile, $otp)
    {
        $now = Carbon::now();
        $date = Carbon::now()->subMinutes(5);
        
        // Debugging - log the variables
        \Log::info("Verifying OTP for mobile: $mobile, OTP: $otp, Date Range: $date to $now");
        
        $otp = SMS::where('mobile', $mobile)
            ->where('otp', (int)$otp)
            ->whereDate('created_at', '>=', $date)
            ->whereDate('created_at', '<=', $now)
            ->whereNull('verified_at')
            ->first();
    
        // Check if OTP is found
        if (isset($otp->message_id)) {
            // OTP verified
            $otp->update(['verified_at' => now()]);
            return (array("success" => true, "message" => "OTP Verified"));
        } else {
            // OTP failed
            \Log::info("OTP verification failed for mobile: $mobile, OTP: $otp");
            return (array("success" => false, "message" => "OTP Verification Failed"));
        }
    }
    
    
    
