public function sendVerificationSMS($data)
{
    $apiKey = 'N2E1MjRhMzYzNDcyNTY2ZTMzMzA3OTc1NzE0Mjc2Mzk=';
    $sender = 'iZonik';

    $mobile = $data['mobile_number'];
    $outletName = $data['outlet_name'];

    $message ="Dear Customer , Your Outlet $outletName is verified , you can now start placing orders from Order cart .Please contact our Customer care Team Zonik at +919136411489 for further information";

    $data = [
        'apikey' => $apiKey,
        'sender' => $sender,
        'numbers' => $mobile,
        'message' => $message,
    ];

    $ch = curl_init();

    curl_setopt($ch, CURLOPT_URL, 'https://api.textlocal.in/send/');
    curl_setopt($ch, CURLOPT_POST, true);
    curl_setopt($ch, CURLOPT_POSTFIELDS, $data);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);

    $response = curl_exec($ch);
    curl_close($ch);

    // Prepare the log message
    $logMessage = "[" . date('Y-m-d H:i:s') . "] SMS Response: " . print_r($response, true) . PHP_EOL;

    // Save response to logs.txt
    file_put_contents(storage_path('logs/logs.txt'), $logMessage, FILE_APPEND);

    // Log to Laravel log for debugging
    error_log(print_r($response, true));
    $resultStatus = json_decode($response, true);

    if (isset($resultStatus['status']) && $resultStatus['status'] === 'success') {
        $successMessage = "[" . date('Y-m-d H:i:s') . "] Verification message sent successfully to $mobile" . PHP_EOL;
        file_put_contents(storage_path('logs/logs.txt'), $successMessage, FILE_APPEND);
    } else {
        $error = $resultStatus['errors'][0]['message'] ?? 'Unknown error';
        $errorMessage = "[" . date('Y-m-d H:i:s') . "] Failed to send message to $mobile. Error: " . $error . PHP_EOL;
        file_put_contents(storage_path('logs/logs.txt'), $errorMessage, FILE_APPEND);
    }
}




    public function checkBalance()
    {
        $BALANCE_URL = "http://kutility.org/app/miscapi/" . $this->apiKey . "/getBalance/true/";
        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $BALANCE_URL);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, 1);
        curl_setopt($ch, CURLOPT_POST, 1);
        curl_setopt($ch, CURLOPT_POSTFIELDS, "");
        $result = curl_exec($ch);
        if (curl_errno($ch)) {
            return array('success' => false, "message" => curl_error($ch));
        }
        curl_close($ch);
        if ($this->isJson($result)) {
            return array('success' => true, 'data' => json_decode($result, true), "message" => "");
        } else {
            return array('success' => false, "message" => $result);
        }
    }

    public function isJson($string)
    {
        json_decode($string);
        return (json_last_error() == JSON_ERROR_NONE);
    }
