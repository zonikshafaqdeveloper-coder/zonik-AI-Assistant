    public function update(Request $request, $id)
    {
        $request->validate([
            'in_invoice' => 'required|in:yes,no',
        ]);
        $orderItem = OrderItem::findOrFail($id);
        $orderItem->update([
            'in_invoice' => $request->in_invoice,
        ]);

        return redirect()->back()->with('success', 'Order item updated successfully');
    }

    public function destroy($id)
    {
        $orderItem = OrderItem::findOrFail($id);

        $orderId = $orderItem->order_id;
        $productPrice = $orderItem->price;
        $payment = Payment::where('order_id', $orderId)->first();
        if ($payment) {

            $payment->paid_amount -= $productPrice;
            $payment->save();
        }

        $orderItem->delete();

        return response()->json(['message' => 'Order item deleted successfully']);
    }



public function acceptOrder(SmsService $smsService, $orderId)
{
    try {
        // Fetch the order with related data
        $order = Order::with('user', 'items.product')->findOrFail($orderId);
        
        
          $user = User::find($order->user_id); 

        // Check if delivery record exists
        $delivery = DeliveryManagement::where('order_id', $orderId)->first();
        if (!$delivery) {
            Log::error("No delivery record found for order ID {$orderId}.");
            return response()->json(['error' => 'Delivery record not found'], 404);
        }

        // Check if shipping pincode exists in database or fetch from API
        $maharashtrian = 'False'; // Default to False
        $shipping_pincode = $order->shipping_pincode;

        if ($shipping_pincode) {
            $pincodeRecord = Pincode::where('pincode', $shipping_pincode)->exists();

            if ($pincodeRecord) {
                $maharashtrian = 'True';
            } else {
                $response = file_get_contents("https://api.postalpincode.in/pincode/$shipping_pincode");
                $data = json_decode($response, true);

                if (!empty($data[0]['PostOffice'][0]['State']) && $data[0]['PostOffice'][0]['State'] === 'Maharashtra') {
                    $maharashtrian = 'True';
                }
            }
        }

        // Update delivery status
        $delivery->delivery_status = 'in_progress';
        $delivery->save();

        // Set invoice date
        $order->invoice_date = now();

        // Initialize total calculations
        $totalAmount = 0;
        $totalcgstamount = 0;
        $totalsgstamount = 0;
        $totaligstamount = 0;
        $totalcessamount = 0;

        // Loop through order items to calculate values
        foreach ($order->items ?? [] as $orderItem) {
            $product = $orderItem->product ?? null;
            if (!$product) {
                Log::error("Product not found for order item ID {$orderItem->id} in order {$orderId}");
                continue;
            }

            // Calculate pre-tax amount
            $pretax = (float) $orderItem->quantity * (float) $orderItem->offer_price;


            // Determine GST type based on location
            $cess = 0;
            if ($maharashtrian === 'False') {
                // Apply IGST only for outside Maharashtra
                $igst = $product->igst ?? 0;
                $sgst = 0;
                $cgst = 0;
            } else {
                // Apply CGST + SGST for Maharashtra
                $sgst = $product->sgst ?? 0;
                $cgst = $product->cgst ?? 0;
                $igst = 0;
            }

            // Total GST percentage
            $totalTaxes = $sgst + $cgst + $igst + $cess;

            // Calculate tax amounts
            $cgstAmount = ($cgst * $pretax) / 100;
            $sgstAmount = ($sgst * $pretax) / 100;
            $igstAmount = ($igst * $pretax) / 100;
            $cessAmount = ($cess * $pretax) / 100;

            // Accumulate total tax amounts
            $totalcgstamount += $cgstAmount;
            $totalsgstamount += $sgstAmount;
            $totaligstamount += $igstAmount;
            $totalcessamount += $cessAmount;

            // Apply coupon discount if available
            $couponDiscount = $orderItem->coupon_discount ?? 0;

            // Calculate correct total amount
            $totalAmount += $pretax + $cgstAmount + $sgstAmount + $igstAmount + $cessAmount - $couponDiscount;
        }

        // Save Total Amount in `total_discount_value`
        $order->total_discount_value = $totalAmount;
        $order->save();

        Log::info("Order ID {$orderId} updated: Total Discount Value (Total Amount) = ₹{$totalAmount}");

        // Notify customer
        $notificationMessage = "Your order (ID: {$order->order_id}) is now in progress. Your total amount after discount is ₹" . number_format($totalAmount, 2);
        // $order->user->notify(new NewEnqueryRequestCustomerNotification($order->user->id, $notificationMessage));
        
         $user->notify(new NewEnqueryRequestCustomerNotification($user->id, $notificationMessage));

        // Send SMS
        $data = [
            'order' => $order,
            'delivery' => $delivery,
        ];
        $smsService->sendOrder($data);

        Log::info("SMS sent to user {$order->user->id} for order {$orderId}.");

        return back()->with('success', 'Order accepted, values updated, and customer notified successfully.');

    } catch (\Exception $e) {
        Log::error("Error accepting order: " . $e->getMessage(), ['trace' => $e->getTraceAsString()]);
        return response()->json(['error' => 'An error occurred while processing the order. ' . $e->getMessage()], 500);
    }
}






        


    

    public function cancelOrder($orderId)
{
    // Update delivery status to 'cancelled'
    DeliveryManagement::where('order_id', $orderId)->update(['delivery_status' => 'cancelled']);

    // Find the order
    $order = Order::find($orderId);
    if ($order) {
        // Log the order cancellation action
        Log::info("Order {$order->order_id} has been cancelled. Delivery status updated.");

        // Construct the notification message
        $notificationMessage = "Your order (ID: {$order->order_id}) has been cancelled. If you have any questions, please contact support.";

        // Get the logged-in user (the one who canceled the order)
        $cancelingUser = auth()->user(); // Assuming the user is authenticated

        // Send notification to the customer (user_id is for the customer who placed the order)
        $customer = User::find($order->user_id); // Get the user (customer) who placed the order
        if ($customer) {
            // Send notification to the customer
            $customer->notify(new NewEnqueryRequestCustomerNotification($customer->id, $notificationMessage));

            // Log the notification action
            Log::info("Notification sent to user {$customer->id} for cancelled order {$order->order_id}.");
        } else {
            // Log error if user is not found
            Log::error("User not found for order {$order->order_id}. Cannot send cancellation notification.");
        }

        // Send notification to the admin
        $adminNotification = new OrderNotification();
        $adminNotification->user_id = $customer->id;
        $adminNotification->title = "{$cancelingUser->name} cancelled order {$order->order_id}";

        // Generate URL with order details route
        $adminNotification->click_url = route('orderitem.details', ['id' => $order->id], false);

        // Save admin notification
        $adminNotification->save();

        // Log the admin notification
        Log::info("Admin notification sent: {$cancelingUser->name} cancelled order {$order->order_id}.");

        // Return success response
        return response()->json(['message' => 'Order cancelled and customer notified successfully']);
    } else {
        // If order not found, log the error and return error response
        Log::error("Order with ID {$orderId} not found.");
        return response()->json(['error' => 'Order not found'], 404);
    }
}

    


