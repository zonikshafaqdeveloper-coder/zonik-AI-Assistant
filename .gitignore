# Local configuration and secrets
**/.env
**/.env.*
!**/.env.example

# Installed dependencies
**/vendor/
**/node_modules/

# Laravel runtime data
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/fonts/*
/bootstrap/cache/*.php
/public/uploads/
/public/uploads.*/
/public/*_debug_log.txt

# Test and editor artifacts
**/.phpunit.result.cache
**/.idea/
**/.vscode/

# Backups, archives, and database dumps
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.gz
*.bz2
*.7z
*.sql

# OS-generated files
.DS_Store
Thumbs.db
